# TypeSafe AI (Jev) Credentials
# Sign up at https://typesafe.ai to obtain your API key.
# If left blank, the app runs in simulated demo mode for local exploration.
TYPESAFE_API_KEY=your_typesafe_api_key
TYPESAFE_MODEL=jev-latest
TYPESAFE_API_URL=https://api.typesafe.ai/v1/systemone
TYPESAFE_TIMEOUT=30.0

# Optional LangChain + Groq Reply Generation Layer
# Obtain a free API key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.1-8b-instant

# Optional Real-Time Webhook Alerting (Slack or Discord)
# If left blank, critical alerts are logged to the console / audit trail.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# Application Settings
PORT=8080
HOST=0.0.0.0
